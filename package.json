{
  "name": "verzel-store-testes",
  "version": "1.0.0",
  "description": "Teste técnico QA Júnior Verzel (VZS-142): cenários BDD da Verzel Store com Playwright + Cucumber",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "cucumber-js --tags \"@ui and not @manual\"",
    "test:api": "cucumber-js --tags \"@api and not @manual\"",
    "test:chromium": "node scripts/run-browsers.js chromium",
    "test:firefox": "node scripts/run-browsers.js firefox",
    "test:webkit": "node scripts/run-browsers.js webkit",
    "test:all": "node scripts/run-browsers.js chromium firefox webkit",
    "test:visual": "node scripts/run-browsers.js chromium firefox webkit -- --tags @visual",
    "test:visual:update": "node scripts/update-visual.js",
    "postinstall": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.63.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
